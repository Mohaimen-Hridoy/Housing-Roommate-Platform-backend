{
  "name": "housing-backend",
  "version": "1.0.0",
  "description": "Apollo B7A6 Housing & Roommate Platform - Node.js/TypeScript/Express backend",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"eslint.config.js\" \"jest.config.js\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:ci": "jest --ci --coverage --maxWorkers=1",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force --skip-generate --skip-seed && prisma db seed",
    "open:gen": "node scripts/gen-openapi.js",
    "open:postman": "node scripts/gen-postman.js",
    "docs:gen": "npm run open:gen && npm run open:postman"
  },
  "keywords": [
    "housing",
    "roommate",
    "prisma",
    "express",
    "stripe"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^2.4.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "http-status": "^1.7.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.14",
    "stripe": "^13.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@typescript-eslint/type-utils": "^8.10.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
