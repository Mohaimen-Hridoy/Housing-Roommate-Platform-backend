# ---------------------------------------------------------------------------
# Apollo B7A6 Housing & Roommate Platform - Backend Environment Configuration
# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# Defaults shown are for local development only.

# --- Core ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- App API base ---
# Used to build absolute URLs (e.g. Stripe success/cancel/webhook URLs).
APP_URL=http://localhost:4000
API_BASE_URL=/api/v1
WEB_APP_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://housing:housing_secret@localhost:5432/housing_dev?schema=public

# --- Security / CORS ---
# Comma-separated list of allowed origin strings/regexes.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=housing-backend
# Bcrypt cost factor
BCRYPT_ROUNDS=12

# --- Google OAuth (optional, toggle with GOOGLE_OAUTH_ENABLED) ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/v1/auth/google/callback

# --- Stripe (real payment integration) ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=replace_with_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_CURRENCY=usd
# Percentage the platform keeps as a (simplified) handling fee.
STRIPE_PLATFORM_FEE_PERCENT=5.0

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# --- Email (dev = console; prod = SMTP via provider) ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@housing.local

# --- Observability ---
LOG_LEVEL=info

# --- File / image storage ---
# auto  = use Cloudinary when its credentials are present, otherwise local disk
# cloudinary = force Cloudinary, local = force local disk
STORAGE_DRIVER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=housing
# Local-disk driver only. Served from APP_URL + UPLOAD_URL_PREFIX.
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_MAX_FILES=6
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif

# --- Caching (optional) ---
# Leave REDIS_URL empty to use the in-process memory cache.
REDIS_URL=
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
